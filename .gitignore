# Local scratch area (already excluded from the Jekyll build via _config.yml)
/tmp/
/research/quant-interview-notes/

__pycache__/
*.py[cod]
*.log

# Shell-fragmented download leftovers: when a pasted command such as
# `curl --compressed -LsSf https://… -o FILE` is used as a path, each token
# becomes a directory at the repo root. Keep them out of git if it happens again.
/-*/
/curl/
/https:*/

# Offline PDFs are delivered directly as local files; do not publish them.
/notes/downloads/*.pdf

# Local study notes: retain on this machine, never sync to the website repo.
/_pages/unlisted-notes.html
/_data/unlisted_notes.local.yml
/notes/unlisted/
